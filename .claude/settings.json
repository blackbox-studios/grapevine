{
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(npm run db:reset:*)",
      "Bash(npm run db:reset*)"
    ],
    "ask": [
      "Bash(npx prisma migrate:*)",
      "Bash(prisma migrate:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma db execute:*)",
      "Bash(npm run prisma:migrate:*)",
      "Bash(npm run prisma:migrate*)",
      "Bash(npm run db:secure:*)",
      "Bash(npm run db:secure*)",
      "Bash(npm run prisma:seed:*)",
      "Bash(npm run prisma:seed*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); case \"$cmd\" in *\"git commit\"*) bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/check-secrets.sh\";; esac"
          }
        ]
      }
    ]
  }
}
