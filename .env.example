# Ozora — environment template.
# Copy this file to .env.local and fill in the real values. Never commit secrets.
#   cp .env.example .env.local
#
# Loaded by Next.js: .env.local overrides .env. Both are gitignored; this
# .env.example is the committed source of truth for what the app expects.

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL of THIS app. Must match where the app is served and the Auth0
# app's Allowed Callback/Logout URLs (callback = APP_BASE_URL + /auth/callback).
# Local dev: http://localhost:3000   Prod: https://app.ozora.com
APP_BASE_URL=http://localhost:3000

# Optional: serve the app under a subpath (e.g. /emc/ui). Leave blank for root.
# NEXT_PUBLIC_BASE_PATH=

# ── Auth0 ─────────────────────────────────────────────────────────────────────
# Tenant domain — no scheme (e.g. your-tenant.us.auth0.com, or login.ozora.com
# once a custom domain is configured). Application type must be "Regular Web App".
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Application (client) credentials from Auth0 → Applications → your app → Settings.
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret       # secret — keep out of git

# Session encryption key for the SDK cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=generate-with-openssl-rand-hex-32   # secret — keep out of git
