{
    "appId": "com.throughgrapevine.app",
    "appName": "Grapevine",
    "webDir": "out",
    "backgroundColor": "#0a1014",
    "ios": {
        "contentInset": "never",
        "backgroundColor": "#0a1014"
    },
    "android": {
        "backgroundColor": "#0a1014",
        "webContentsDebuggingEnabled": true
    },
    "plugins": {
        "SplashScreen": {
            "launchAutoHide": false,
            "backgroundColor": "#0a1014",
            "showSpinner": false,
            "androidScaleType": "CENTER_CROP"
        },
        "StatusBar": {
            "style": "DARK"
        },
        "Keyboard": {
            "resize": "none",
            "style": "DARK",
            "resizeOnFullScreen": true
        },
        "FirebaseMessaging": {
            "presentationOptions": []
        }
    }
}
