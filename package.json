{
  "name": "grapevine",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/patch-route-manifests.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "build:native": "NEXT_PUBLIC_NATIVE=1 next build",
    "sync": "npm run build:native && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "release:android": "node scripts/release-android.mjs",
    "apk": "npm run sync && cd android && ./gradlew assembleRelease",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:secure": "node scripts/apply-policies.mjs",
    "storage:setup": "node scripts/setup-storage.mjs",
    "db:seed": "prisma db seed",
    "db:seed:prod": "SEED_TARGET=prod node prisma/seed.js",
    "db:reset": "node scripts/assert-local-db.mjs \"db:reset\" && prisma migrate reset --force --skip-seed && npm run db:secure && npm run db:seed",
    "postinstall": "prisma generate",
    "owner": "node scripts/grant-owner.mjs",
    "reviewer": "node scripts/provision-reviewer.mjs",
    "erase": "node scripts/erase-account.mjs",
    "comments:rescore": "node scripts/rescore-comments.mjs",
    "signups:remind": "node scripts/send-reminders.mjs",
    "dev:login": "node scripts/dev-login.mjs",
    "dev:reset-member": "node scripts/dev-reset-member.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.2.1",
    "@supabase/supabase-js": "2.112.3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "capacitor-native-settings": "^8.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "copy-to-clipboard": "^4.0.2",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "immer": "^11.1.9",
    "input-otp": "^1.4.2",
    "jose": "^6.2.9",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "^15.5.22",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.10.40",
    "dotenv": "^16.4.7",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prisma": "^6.2.1",
    "shadcn": "^4.12.0",
    "sharp": "^0.34.5"
  }
}
