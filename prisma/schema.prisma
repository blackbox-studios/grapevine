// Prisma schema. Docs: https://pris.ly/d/prisma-schema
//
// The domain behind Grapevine: invite-only, organization-scoped feeds for Orthodox
// parishes and dioceses. Supabase owns credentials (auth.users); everything below
// is application data, owned by this schema and reached only through the services
// in `src/lib/server/*.service.js`.
//
// Two ideas carry most of the design and are worth reading before changing anything:
//
//  1. **Permission, vocation and platform authority are three different axes.**
//     `Membership.role` (ADMIN | MEMBER) decides what you may *do inside one group*, so
//     one person can administer their parish while being an ordinary member of the
//     diocese. `Profile.vocation` (PRIEST | FAITHFUL) is who someone *is*, and it is
//     global and purely presentational. `Profile.platformRole` (NONE | OWNER) is
//     authority over the *app*, not over any group — the right to bring a group into
//     existence, which no per-group role can express because the group does not exist
//     yet. A priest is usually the admin of their parish but not necessarily, an admin
//     need not be a priest, and an owner is an ordinary member of every group they did
//     not create. Collapsing any two of these into one field is the mistake this split
//     exists to prevent.
//
//  2. **Access is a membership row, not a flag.** An APPROVED row is what makes an
//     organization's posts visible in your feed. Revoking access is a status change,
//     which keeps the history rather than deleting it.
//
// Sign-in itself is gated one level further up, by Supabase: the client calls
// `signInWithOtp({ shouldCreateUser: false })`, so an email with no `auth.users` row
// can never obtain a code. Provisioning a user is therefore the only way in, which
// is what makes the app invite-only.
//
// ── Admission is one-directional ────────────────────────────────────────────
//
// **An admin admits people. A person never asks to join, and there is nothing to
// approve.** This is a deliberate constraint on the domain, not a feature that has
// not been built yet, and the schema is shaped to make the other shape impossible:
// `MembershipStatus` is APPROVED | REVOKED, with no PENDING request and no REJECTED
// refusal, so an unapproved membership is not a state that can be represented.
//
// It follows from the invite-only gate above. A request-to-join flow needs a public
// entry point where a stranger identifies themselves, and `shouldCreateUser: false`
// means that stranger can never receive a sign-in code anyway — so the request would
// be from someone who by construction cannot act on the answer. Admission writes the
// Supabase user, the Profile, and an APPROVED Membership in one step (`admitOne`);
// the person simply signs in.
//
// If a parish ever does want people to be able to ask, that is a new model — a
// JoinRequest with its own table and its own gate — not a third value on this enum.
// Putting it back here is what produced a roster with an Approve button that nothing
// could ever populate.
//
// The shape that would want it is already visible: a member reads somebody's profile,
// sees a group they are not in, and asks to be let in. Note what that is and is not.
// It is *not* the stranger the invite-only gate exists to keep out — the asker is
// already provisioned, already signed in, and can act on the answer — so it does not
// reopen `shouldCreateUser: false`. And it is still not a membership state: the request
// is a row that resolves into a Membership or into nothing, so `admitOne` remains the
// one thing that grants access and every read path keeps asking the one question it
// asks today. Which is why the profile surface deliberately does **not** list a
// person's groups: naming a group to somebody with no membership in it is the leak that
// would have to be designed for first, and there is nothing to gain by shipping it early.
//
// ── Naming ──────────────────────────────────────────────────────────────────
//
// Models and fields are camelCase in the Prisma client (which is what app code
// sees) and **snake_case in Postgres**, via `@@map` / `@map`. Postgres folds
// unquoted identifiers to lowercase, so a mixed-case table has to be quoted
// forever — in every raw query, every psql session, and every statement typed into
// the Supabase SQL editor. `select * from post` failing with `relation "post" does
// not exist` while `select * from "Post"` works is a papercut with no upside.
// Adding a model means adding its `@@map`; the migration is where this is settled,
// and changing it later means renaming every table in a live database.
//
// ── Row Level Security ──────────────────────────────────────────────────────
//
// Prisma cannot express RLS, and these tables live in `public`, which Supabase's
// Data API can expose. `prisma/policies.sql` locks them down and MUST be applied
// after every migration — see the header of that file for why this is not optional
// even though nothing in this app talks to Supabase over the Data API.

generator client {
  provider        = "prisma-client-js"
  // relationJoins lets a query opt into `relationLoadStrategy: "join"`, which resolves an
  // `include` with lateral joins in one statement instead of one SELECT per relation.
  // The services use it on the reads that fan out (the feed page, a comment page, the
  // viewer + their memberships) — see the JOIN note in lib/server/posts.service.js.
  // Postgres-only, which is what this project is.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app at runtime. Which Supabase pooler it names is decided by
  // how the target runs, and the wrong one is an outage rather than a slowdown.
  //
  // Session mode (5432) is the faster of the two: prepared statements and one round trip
  // per query. Transaction mode (6543 + `?pgbouncer=true`) hands out a connection per
  // statement, so Prisma must disable named prepared statements and bracket every single
  // query in its own transaction: BEGIN, DEALLOCATE ALL, the SELECT, COMMIT — four round
  // trips to run one. A page of comments measured 23 statements and 1.28s that way,
  // against 8 statements and 0.59s on the session pooler, with identical SQL.
  //
  // But session mode allots this database user only 15 clients and holds one per Prisma
  // connection for that connection's life, so it fits exactly one shape: a long-lived
  // server (`next start`, `next dev`) with one bounded pool. Serverless does not fit —
  // every warm instance keeps its own pool and releases nothing between invocations, so
  // the allotment is exhausted by idle capacity at a concurrency of one or two, and since
  // every route calls requireViewer the whole API fails together with EMAXCONNSESSION.
  // Vercel is serverless, so production runs on 6543 with connection_limit=1 and pays the
  // round trips above. See .env.example.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) for migrations. Prisma Migrate takes advisory locks
  // and issues DDL, neither of which survives a transaction pooler, so it must bypass
  // it. Only the CLI uses this.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

/// A user's application profile. `id` is the Supabase `auth.users.id` verbatim, so
/// the JWT's `sub` claim resolves a profile with no lookup table in between.
///
/// There is deliberately no foreign key to `auth.users`: that table lives in the
/// `auth` schema, which Prisma does not manage, and pointing a constraint at another
/// service's table would make every migration depend on Supabase's internals. The
/// rows are kept in step by the provisioning path in `prisma/seed.js` and the invite
/// service instead — both create the auth user and the profile together.
model Profile {
  /// Mirrors auth.users.id.
  id     String @id @db.Uuid
  email  String @unique
  /// Public @handle. Distinct from email so a display identity can change without
  /// touching the credential. `@unique` already provides the lookup index.
  ///
  /// Chosen by the person during first-run orientation, not assigned. Admission still
  /// derives a provisional one from the email local part, because an admin inviting
  /// somebody knows only their address — orientation is where they replace it.
  handle String @unique

  /// The person's legal name, in two parts, supplied by them during orientation.
  ///
  /// **These two are never a title and never a rank.** They are what a passport says, and
  /// they exist to be sorted and searched on: the roster orders a parish by surname, which
  /// a name with a title welded onto the front cannot serve. `fullName()` in `lib/name.js`
  /// is the only thing that joins them, and there is no `fullName` column for that reason
  /// — a stored join is a third copy of two facts that can disagree with them.
  ///
  /// How a person is *addressed* is `displayName` below, which is a separate column because
  /// it is a separate fact. See it.
  ///
  /// Nullable because admission provisions a Profile from an email address alone; both are
  /// non-null from the moment orientation completes. A profile with no name yet renders as
  /// its handle. See `completeOnboarding`.
  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  /// How this person is addressed everywhere their name appears — a byline, a comment, a
  /// push banner, a follower list. "Priest Alexander", "Dn. Paul", "Rob".
  ///
  /// **Typed by the person, not composed from the columns around it, and the composition is
  /// what has no correct answer.** `vocation` + `patronSaint` looks like it should produce
  /// this, but a patron saint is not a first name: it is the saint written the way the Church
  /// writes him, so "The Right-Believing Prince Alexander Nevsky" is a correct value in that
  /// column and an impossible one to prefix with a rank. Prefixed anyway it reads "Priest
  /// Right Believing Prince Alexander Nevsky", which is not a person's name in any register —
  /// and no rule over the two columns repairs it, because the one holding the long form is
  /// holding the right thing. So the person says what to call them.
  ///
  /// The cost is real and is accepted: ordaining a reader as a deacon is a vocation change
  /// **and** a name edit, because nothing derives this. `suggestDisplayName()` in
  /// `lib/name.js` is what keeps that cheap — it proposes "Dn. Paul" into one field — and it
  /// is only ever a suggestion, because the whole point is that the last word is the person's.
  ///
  /// Null means "not set", and `displayName()` falls back to the legal name and then to the
  /// handle. It stays null for most laity: orientation asks for it only from the ranks a name
  /// is conferred with (`RANKED_VOCATIONS`), where the question has an answer nobody
  /// can derive. Everyone else is called what their name is.
  displayName String? @map("display_name")

  avatarUrl String?  @map("avatar_url")
  /// Who the person is, not what they may do. See the header note.
  vocation  Vocation @default(FAITHFUL)

  /// The saint this person is named for, written as the Church writes him.
  ///
  /// **Not "baptism name", and the difference is not wording.** The name is given at baptism
  /// or chrismation, but it is given *again* at tonsure and at consecration: a man baptised
  /// David may be tonsured under a monastic name and consecrated Bishop Daniel, and each one
  /// replaces the last. One column holds the current patron, because the current one is the
  /// only one that answers anything.
  ///
  /// Held apart from `firstName` because for most people the two differ — someone baptised
  /// Nicholas may go by Nick, or by a legal name with no saint behind it at all.
  ///
  /// **It is free to be as long as the saint is**: "The Right-Believing Prince Alexander
  /// Nevsky" belongs in this column, and the length is why the column is named for a saint
  /// rather than for a name. Nothing composes a byline out of it — that is `displayName`
  /// above, which a person types. It is the Patron column on `<ProfileCard/>` and what makes
  /// the name-day digest legible, and both want the full form.
  ///
  /// Null for a catechumen, who has not been given one yet, and orientation does not ask
  /// them for one; null afterwards means only "not supplied".
  patronSaint String? @map("patron_saint")

  /// The patronal feast this person keeps — a **month and a day, with no year**, because
  /// that is what a name day is. Split into two small integers rather than stored as a date
  /// for exactly that reason: a `@db.Date` would force a meaningless year onto the column,
  /// which then has to be ignored by every reader and is one timezone slip from moving the
  /// feast.
  ///
  /// **The shape is chosen for the query it exists to serve**: "whose name day falls this
  /// week", which the parish's priest will want as a weekly digest. A seven-day window is
  /// seven `(month, day)` pairs, so that read is an `IN` over the index below — exact, and
  /// with no special case at a year boundary, which a single ordinal column would need.
  ///
  /// Both are null or both are set; nothing represents half a date. `readNameDay` is the
  /// only thing that writes them.
  nameDayMonth Int? @map("name_day_month")
  nameDayDay   Int? @map("name_day_day")

  /// When this person was ordained, for the ranks that are.
  ///
  /// Asked for at orientation only of DEACON, PRIEST and BISHOP — see `CLERGY_VOCATIONS` in
  /// `lib/constants.js`. A READER is *tonsured* rather than ordained and a MATUSHKA is not
  /// clergy at all, so neither is asked; the column stays open to them because a vocation can
  /// change and nothing here should have to be migrated when it does.
  ///
  /// `@db.Date` for the same reason a birthday is one: it is a calendar date, not an instant.
  ordinationDate DateTime? @map("ordination_date") @db.Date

  /// Authority over the platform, held by a person rather than granted inside a group.
  /// The subscriber's axis: see the `PlatformRole` note below.
  platformRole PlatformRole @default(NONE) @map("platform_role")

  /// **There is no `verified` column.** The check on a post card means "this person
  /// administers the group you are reading this in", which is already recorded — it is
  /// `Membership.role == ADMIN`. Storing it a second time as a profile flag created a fact
  /// that could disagree with the permission it claimed to describe: revoking someone's
  /// admin role left them wearing the check, because nothing connected the two.
  ///
  /// It is derived per post, against that post's organization, in `projectAuthor` — so the
  /// same person can carry the check in the parish they administer and not in the diocese
  /// where they are an ordinary member. A global flag could not express that.

  /// Date of birth, collected during first-run orientation.
  ///
  /// `@db.Date` rather than a timestamp on purpose: a birthday is a calendar date, not an
  /// instant. Stored as a timestamp it would acquire a time and a timezone, and someone
  /// born on the 1st would start rendering as the 31st for readers west of the server.
  birthday DateTime? @db.Date

  /// When orientation was completed. Null means they have signed in but not finished it,
  /// which is a state the roster shows and the gate acts on — see `access` in
  /// `lib/server/projections.js`.
  onboardedAt DateTime? @map("onboarded_at")

  /// Last time this profile was seen by the API. **Null means they have never signed in**,
  /// which is how an admin tells an invitation that has been taken up from one that has
  /// not. Stamped by `touchProfile`, throttled so an active session is not a database
  /// write per request.
  ///
  /// Kept here rather than read from `auth.users.last_sign_in_at`, which is visible today
  /// but lives in a schema Supabase owns and has been progressively locking down.
  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  orgsCreated         Organization[]            @relation("OrgCreator")
  posts               Post[]
  comments            Comment[]
  postLikes           PostLike[]
  commentLikes        CommentLike[]
  notifications       Notification[]            @relation("NotificationRecipient")
  notified            Notification[]            @relation("NotificationActor")
  devices             DeviceToken[]
  invitesSent         Invite[]                  @relation("InviteInviter")
  membershipsRuled    Membership[]              @relation("MembershipDecider")
  following           Follow[]                  @relation("FollowFollower")
  followers           Follow[]                  @relation("FollowFollowing")
  participations      ConversationParticipant[]
  messages            Message[]
  conversationsOpened Conversation[]            @relation("ConversationCreator")
  cryptoDevices       CryptoDevice[]
  blocksMade          MessageBlock[]            @relation("BlockMade")
  blocksReceived      MessageBlock[]            @relation("BlockReceived")
  sheetsCreated       SignupSheet[]             @relation("SheetCreator")
  claims              SignupClaim[]

  /// Serves the name-day digest — "whose feast falls in this window" — which is the only
  /// reason the two name-day columns are split the way they are. Nothing else reads them.
  @@index([nameDayMonth, nameDayDay])
  @@map("profile")
}

/// Where someone stands in the life of the parish. **Presentational only** — a vocation
/// never grants a permission; that is `Membership.role`, and the two are deliberately
/// separate (see the header). A parish can have a Reader who administers the feed and a
/// Priest who does not.
///
/// One value per person, never a set: these are mutually exclusive standings, so a
/// matushka is not also an ordained reader. That is why this is an enum column rather than
/// a collection of flags — the schema makes the invalid combination unrepresentable
/// instead of leaving it to validation.
///
/// Declared in ecclesiastical order, and that ordering is load-bearing: Postgres sorts an
/// enum by declaration order, not alphabetically, so this is what the roster sorts on.
/// Inserting a rank in the middle later means a type recreate, not an `ADD VALUE` — get
/// the order right now.
/// Authority over the platform itself, attached to a **person** rather than to a group.
///
/// ── Why a third axis and not a role ─────────────────────────────────────────
///
/// This is the subscriber. Someone buys Grapevine for their parish, and what they buy is
/// the right to *build* — to bring groups into existence and to tear down the ones they
/// brought. Neither existing axis can say that. `Membership.role` is scoped to a group, and
/// the group being created does not exist yet, so there is no row to hang the permission
/// off; `vocation` grants nothing by construction and must not start. So it is a third
/// column, kept apart from the other two for exactly the reason those two are kept apart.
///
/// ── What OWNER is, and what it is deliberately not ──────────────────────────
///
/// OWNER grants exactly two things: create a group, and delete a group **you created**. It
/// is **not** a master key. An owner has no standing in a parish they did not create — they
/// cannot read its feed, its roster, or its members, and `requireViewer`'s membership
/// scoping is untouched by this column. A priest who subscribes so he can run a catechumen
/// group does not thereby acquire the diocese's roster, and the diocese's owner does not
/// acquire his. That isolation is the product promise, not a hardening detail.
///
/// **An owner's authority inside a group they created is a real `Membership` row**, written
/// by `createOrg` in the same transaction as the group and protected from removal by
/// `updateMembership`. It is not derived from this column at read time. That keeps the
/// schema's second idea intact — access is a membership row, not a flag — so the owner
/// appears in their own roster, their posts carry the admin check, and every authorization
/// path in the app keeps asking one question instead of two.
///
/// ── Not assignable through the app ──────────────────────────────────────────
///
/// Nothing in `/api` writes this column, and that is on purpose: an endpoint that grants
/// platform authority is a privilege-escalation surface guarding a role that changes hands
/// perhaps twice a year. It is granted out of band by `scripts/grant-owner.mjs`
/// (`npm run owner -- <email>`), which runs on a trusted machine with the database URL —
/// the same trust boundary the seeds already have. When billing exists, that script is what
/// the webhook calls.
enum PlatformRole {
  NONE
  OWNER

  @@map("platform_role")
}

enum Vocation {
  CATECHUMEN
  FAITHFUL
  READER
  /// A priest's wife. Slavic usage deliberately, not the Greek "Presbytera".
  MATUSHKA
  DEACON
  PRIEST
  BISHOP

  @@map("vocation")
}

// ─────────────────────────────────────────────────────────────────────────────
// Organizations ("Groups" in the UI)
// ─────────────────────────────────────────────────────────────────────────────

/// A parish, diocese, monastery, or any smaller circle a priest wants to keep separate —
/// see `OrgKind`. The self-relation models the real hierarchy (a diocese contains parishes)
/// so that "a diocese feed is its own posts plus its parishes'" becomes a query change later
/// rather than a migration — walk `children` and widen the `orgId IN (...)` set in
/// `listFeed`.
model Organization {
  id        String  @id @default(cuid())
  /// URL-safe identifier, e.g. "holy-trinity-cathedral".
  slug      String  @unique
  name      String
  kind      OrgKind @default(PARISH)
  avatarUrl String? @map("avatar_url")
  /// Short description shown on the Groups surface.
  bio       String?

  /// The parish's own calendar, as a **public** Google Calendar the parish already keeps —
  /// pasted by an admin as whatever URL they had to hand (the embed link off the calendar's
  /// settings page is what they will actually have).
  ///
  /// **Stored exactly as it was typed, and normalized on read** by `icsFeedUrl` in
  /// `lib/utils.js`. Two different strings name the same calendar — the `.../embed?src=…`
  /// link and the `.../ical/…/public/basic.ics` feed — and the one a person can find is not
  /// the one a server can fetch. Storing the raw value means the settings form shows back
  /// what was pasted rather than a machine-readable rewrite of it, and a normalization rule
  /// that turns out to be wrong is a code fix rather than a data migration.
  ///
  /// Null means the group has no calendar, which is the ordinary state: the Events surface
  /// then shows sign-ups alone and says so, rather than showing an error.
  ///
  /// **It is a feed, not an embed.** Nothing renders this URL in an iframe — the events are
  /// fetched as iCalendar and drawn by the app, which is what lets a parish service and a
  /// sign-up slot sit on the same day of the same grid. See `lib/server/calendar.service.js`.
  calendarUrl String? @map("calendar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The platform OWNER who created this group through `POST /api/orgs`, and the only person
  /// who may delete it. Read it as the subscription boundary: a group belongs to whoever
  /// brought it into existence, and one owner's groups are invisible to another's.
  ///
  /// **Nullable, and null means the group belongs to nobody** — so nobody can delete it. The
  /// seeds assign an owner when they create a group (`seed.prod.js` gives the Cathedral to its
  /// own priest, and repairs the column on an existing row), so the only way to reach this
  /// state is an owner whose profile was deleted. Promoting some other owner into the empty
  /// slot would be exactly the cross-subscriber reach this column exists to prevent, so
  /// reassigning is a deliberate act rather than a fallback.
  ///
  /// `SetNull` rather than `Cascade`: deleting a person must never delete a parish's entire
  /// history as a side effect. The group survives, ownerless, and a new owner is set by the
  /// same back door that grants the role.
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("OrgCreator", fields: [createdById], references: [id], onDelete: SetNull)

  parentId String?       @map("parent_id")
  parent   Organization? @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children      Organization[] @relation("OrgHierarchy")
  memberships   Membership[]
  posts         Post[]
  invites       Invite[]
  sheets        SignupSheet[]
  notifications Notification[]

  @@index([parentId])
  /// Serves "which groups does this owner own", which is the delete authorization check and
  /// the future owner console. Also keeps the ON DELETE SetNull above off a sequential scan.
  @@index([createdById])
  @@map("organization")
}

/// A classification carried for the record. It grants nothing, nothing branches on it, and no
/// screen renders it — **every group behaves identically**, which is why the create form does
/// not ask and `updateOrg` refuses to change it.
///
/// It is kept rather than dropped because the rows that predate it genuinely are what they say
/// (a cathedral parish under a diocese), and this column is the only place that distinction is
/// written down. GROUP is the residual and the default `createOrg` applies, so nothing new has
/// to claim to be a canonical body.
enum OrgKind {
  PARISH
  DIOCESE
  MONASTERY
  GROUP

  @@map("org_kind")
}

/// The join between a person and an organization, and the app's central
/// authorization record. Read it as a sentence: this profile has this role in this
/// organization, and that grant is in this state.
///
/// `status` is the access gate — only APPROVED contributes an organization's posts to
/// a viewer's feed. `role` is the permission — only ADMIN may post. Both are checked
/// server-side in `requireMembership`.
model Membership {
  id          String           @id @default(cuid())
  profileId   String           @map("profile_id") @db.Uuid
  orgId       String           @map("org_id")
  role        OrgRole          @default(MEMBER)
  /// Defaults to APPROVED because admission is the only way a row is created, and
  /// admission always grants access. A row that exists but does not grant anything
  /// would be a member nobody can see and no screen can repair.
  status      MembershipStatus @default(APPROVED)
  /// When an admin added this person. Not "requested" — nobody asks to join; see the
  /// admission note in the header.
  admittedAt  DateTime         @default(now()) @map("admitted_at")
  /// When an admin last changed `status` (revoked or restored), and which admin did it.
  decidedAt   DateTime?        @map("decided_at")
  decidedById String?          @map("decided_by_id") @db.Uuid

  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  decidedBy Profile?     @relation("MembershipDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  /// One membership per person per organization; re-admitting updates the row, which
  /// is the way back in for someone previously revoked.
  @@unique([profileId, orgId])
  /// Serves the feed's "which orgs may this viewer read" lookup.
  @@index([profileId, status])
  /// Serves the roster.
  @@index([orgId, status])
  /// Postgres does not index a foreign key automatically, and an unindexed one makes
  /// the ON DELETE SetNull scan the whole table.
  @@index([decidedById])
  @@map("membership")
}

enum OrgRole {
  ADMIN
  MEMBER

  @@map("org_role")
}

/// Two values, and deliberately only two: a person is in the parish or they have been
/// removed from it. There is no PENDING, because nobody can ask to join, and no
/// REJECTED, because there is no request to turn down — see the admission note in the
/// header before adding a third.
///
/// Declaration order is the sort order: Postgres orders an enum by how it was
/// declared, not alphabetically. `listMembers` relies on APPROVED sorting first, so
/// the roster leads with the people actually in the parish.
enum MembershipStatus {
  APPROVED
  REVOKED

  @@map("membership_status")
}

/// The audit trail for an admission: who admitted this address, to what role and
/// vocation, and when.
///
/// **Not a ticket.** There is no token to redeem, no expiry, and no acceptance —
/// `admitOne` provisions the Supabase user, the Profile and an APPROVED Membership on
/// the spot, and the person simply signs in. A redemption link could not work here
/// anyway: it needs an origin to land on, and a Capacitor WebView has none.
///
/// The row is written after the admission and its failure is swallowed, because
/// losing the audit line is not worth failing an admission over.
model Invite {
  id          String   @id @default(cuid())
  email       String
  orgId       String   @map("org_id")
  /// The role and vocation the person was granted.
  role        OrgRole  @default(MEMBER)
  vocation    Vocation @default(FAITHFUL)
  invitedById String   @map("invited_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy Profile      @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  /// One row per email per organization; re-admitting updates it.
  @@unique([email, orgId])
  @@index([orgId])
  @@index([invitedById])
  @@map("invite")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────────────────────

/// A post is always authored *into* an organization — `orgId` is what scopes it to a
/// feed, and there is no such thing as a post outside one. Only an ADMIN of that
/// organization may create one; that is enforced in the service, not here.
model Post {
  id       String  @id @default(cuid())
  orgId    String  @map("org_id")
  authorId String  @map("author_id") @db.Uuid
  title    String?
  body     String

  /// Denormalized tallies. Every feed card renders both, so counting rows per card
  /// would be two extra queries per post per page. They are maintained inside the
  /// same transaction as the like/comment write, so they cannot drift.
  likeCount    Int @default(0) @map("like_count")
  commentCount Int @default(0) @map("comment_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete: a removed post must not take its comment thread with it, and
  /// moderation wants an audit trail. Every read filters on `deletedAt: null`.
  deletedAt DateTime? @map("deleted_at")

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author        Profile        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  comments      Comment[]
  likes         PostLike[]
  notifications Notification[]

  /// The feed's one hot query: posts across the viewer's organizations, newest
  /// first, paged by keyset. The sort columns are in the index in the order the
  /// cursor compares them, so a page is an index range scan rather than a sort.
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@map("post")
}

/// Media attached to a post, one row per item. This shape covers every case the feed
/// renders without a discriminator column: no rows is a text-only announcement, one
/// IMAGE row is a single photo, several IMAGE rows ordered by `position` is the
/// swipeable carousel, a DOCUMENT row is a PDF attachment, and a YOUTUBE row is an
/// embedded video.
///
/// A YOUTUBE row is the one whose `url` was never uploaded here, and it is the only kind
/// exempt from the ownership check in `createPost` — which it earns by being rebuilt from
/// a parsed video id rather than stored as it was pasted (`youtubeId` in `lib/utils.js`).
/// It carries no `width`/`height` and needs none: the player's box is 16:9 whatever was
/// filmed, so the surfaces reserve it from the kind rather than from the data.
///
/// `width`/`height` are the media's intrinsic pixel size and are not optional in
/// practice for images: the feed card reserves the aspect-ratio box from them before
/// the image decodes, and without them the img collapses to zero height on a cold
/// cache and shifts the layout as it loads.
model PostMedia {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  kind      MediaKind @default(IMAGE)
  url       String
  width     Int?
  height    Int?
  mimeType  String?   @map("mime_type")
  /// Display name for a DOCUMENT; ignored for images.
  fileName  String?   @map("file_name")
  /// Byte size of a DOCUMENT. Stored raw and formatted for display at the edge, so the
  /// number stays sortable and comparable instead of being frozen as "142 KB".
  sizeBytes Int?      @map("size_bytes")
  /// Carousel order, ascending.
  position  Int       @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("post_media")
}

enum MediaKind {
  IMAGE
  DOCUMENT
  YOUTUBE

  @@map("media_kind")
}

/// A comment on a post. `parentId` is present but unused by the current UI — it is
/// what makes threaded replies an additive change instead of a migration on a table
/// that will by then hold every comment in the app.
model Comment {
  id        String  @id @default(cuid())
  postId    String  @map("post_id")
  authorId  String  @map("author_id") @db.Uuid
  parentId  String? @map("parent_id")
  body      String
  likeCount Int     @default(0) @map("like_count")

  /// Where this comment sits in its thread — the thread is this column, descending.
  ///
  /// Recency, likes and "the post's author wrote it", collapsed into one number by
  /// `commentScore()` in src/lib/rank.js, which is the only thing that may write it.
  /// Read that module's header before touching this: the reason it is a stored column
  /// and not an `ORDER BY` expression is that the time term scores the comment's
  /// *absolute* timestamp rather than its age, so the value never goes stale on its own
  /// and the whole thread stays pageable by keyset off an index.
  ///
  /// Maintained in the same transaction as the insert and as every like — same argument
  /// as the tallies above. The default is only for the migration that added the column;
  /// nothing in the app inserts a comment without a score.
  score Float @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentThread")
  likes   CommentLike[]

  /// The thread's one hot query: a post's comments in rank order, paged by keyset on
  /// `(score, id)`. Sort columns in the order the cursor compares them, so a page is an
  /// index range scan and not a sort of the whole thread.
  @@index([postId, score(sort: Desc), id(sort: Desc)])
  /// Still here for the pinned block — the viewer's own comments on a post, newest
  /// first, which is the one comment read that is chronological rather than ranked.
  @@index([postId, createdAt, id])
  @@index([parentId])
  /// Without this, deleting a profile cascades with a sequential scan of every comment
  /// in the app — the most expensive of the missing-FK-index cases here.
  @@index([authorId])
  @@map("comment")
}

/// Likes are rows, not counters, because the feed has to answer "did *this viewer*
/// like it" per card. The composite primary key is what makes a double-tap idempotent
/// at the database level rather than in application code.
model PostLike {
  profileId String   @map("profile_id") @db.Uuid
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([profileId, postId])
  @@index([postId])
  @@map("post_like")
}

model CommentLike {
  profileId String   @map("profile_id") @db.Uuid
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([profileId, commentId])
  @@index([commentId])
  @@map("comment_like")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

/// Something somebody did to something you wrote — a like on a post or a comment, a
/// comment on your post, or an admin publishing into a group you belong to. `type` is an
/// enum rather than a boolean precisely so each new kind is a value, not a table.
///
/// **A notification is a row; a push is one delivery of it.** Firebase owns none of this:
/// a device that was asleep when the like landed still finds the row waiting, and the
/// panel reads the same rows whether a push was ever sent.
/// Building the panel out of push payloads instead would make a notification exist only
/// if it happened to be delivered.
///
/// ── One subject column, not two nullable ones ────────────────────────────────
///
/// `subjectId` is whatever the event is *about* — the post or comment that was liked,
/// the comment that was written — and `type` says which. The obvious alternative — a
/// nullable `postId` beside a nullable `commentId` — cannot carry the unique key below:
/// Postgres treats NULLs in a unique index as distinct, so a key containing a column
/// that is always null on one of the paths admits the same like twice. One non-null
/// column keeps the constraint real.
///
/// `postId` is not the subject and is not redundant with it. It is the post the event
/// happened *inside* — the subject itself for a POST_LIKE, the comment's parent for a
/// COMMENT_LIKE or a POST_COMMENT — and it does two jobs nothing else can: it carries
/// the foreign key, so
/// deleting a post takes its notifications with it (including the ones about its
/// comments, which cascade the same way), and it is what the read joins to skip
/// notifications about a post that has since been soft-deleted.
///
/// It is nullable because a FOLLOW happens inside no post at all, which costs those rows
/// both of those jobs and neither is a loss: a follow notification is cascaded by either
/// profile, and there is no post of it to hide. What it does cost is the reads, which
/// have to ask `post_id IS NULL OR post.deleted_at IS NULL` — a filter on the relation
/// alone matches no row whose relation is absent, so it would drop every follow from the
/// panel and from the bell.
///
/// ── One row per actor per subject ────────────────────────────────────────────
///
/// The unique key is what settles like → unlike → like at a single notification instead
/// of three, and it is what an unlike deletes. It is deliberately **not** a grouping
/// key: ten people liking one post are ten rows here, and collapsing them into "Mat.
/// Carly and 9 others" is a read-side question. See the GROUPING note in
/// `lib/server/notifications.service.js`.
model Notification {
  id String @id @default(cuid())

  /// Whose panel this appears in — always the author of the subject.
  recipientId String @map("recipient_id") @db.Uuid
  /// Who did it. Never the recipient: `notify` writes nothing for a self-like.
  actorId     String @map("actor_id") @db.Uuid

  type          NotificationType
  /// What the event is about — the post or comment that was liked, the comment that was
  /// written, or the follower themselves; `type` says which.
  subjectId     String           @map("subject_id")
  /// The post the event happened inside, and null for a FOLLOW. See the header note.
  postId        String?          @map("post_id")
  /// The rota a SIGNUP_PUBLISHED is about, and null for everything else.
  ///
  /// Separate from `signupSlotId` below because the two events happen at different
  /// granularities and pretending otherwise costs the truth: a reminder and a cancellation are
  /// about **one date**, and publishing is about **the rota**. Pointing a publication at the
  /// sheet's first slot would read fine until an admin removed that date, at which point the
  /// cascade would take the announcement of the whole rota with it.
  signupSheetId String?          @map("signup_sheet_id")
  /// The slot a SIGNUP_REMINDER or SIGNUP_CANCELED is about, and null for everything else.
  ///
  /// A second nullable subject column beside `postId`, which the header argues against — and
  /// the argument holds, which is why this is **not** where the subject lives. `subjectId`
  /// still carries it (the reminder row's id, the slot's id), so the unique key below stays
  /// real. This column does the two jobs `postId` does and that `subjectId` cannot: it carries
  /// the foreign key, so cancelling or deleting a slot takes its notifications with it, and it
  /// is what the panel joins to name the sign-up a row is about without a second query.
  signupSlotId  String?          @map("signup_slot_id")
  /// The group an ADDED_TO_GROUP is about, and null for everything else.
  ///
  /// A third nullable link for the same reason `signupSheetId` is a second one: the event is
  /// about a *group*, and there is nothing else on the row that could carry it. It is what
  /// lets the panel name the parish somebody was added to without a query per row, and the
  /// cascade is what stops a deleted group leaving an announcement pointing at nothing.
  orgId         String?          @map("org_id")

  /// Null until the viewer opens the panel — this is what the bell's dot counts.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  recipient   Profile       @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       Profile       @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post        Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  signupSlot  SignupSlot?   @relation(fields: [signupSlotId], references: [id], onDelete: Cascade)
  signupSheet SignupSheet?  @relation(fields: [signupSheetId], references: [id], onDelete: Cascade)
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([recipientId, actorId, type, subjectId])
  /// The panel's one query: this viewer's notifications, newest first, paged by keyset.
  /// The sort columns sit here in the order the cursor compares them, so a page is an
  /// index range scan.
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  /// The unread tally, which is a count over one viewer's unread slice.
  @@index([recipientId, readAt])
  /// Postgres does not index a foreign key automatically, and an unindexed one turns
  /// ON DELETE CASCADE into a sequential scan.
  @@index([actorId])
  @@index([postId])
  @@index([signupSlotId])
  @@index([signupSheetId])
  @@index([orgId])
  @@map("notification")
}

/// Declaration order is not load-bearing here — nothing sorts on this column — but adding a
/// value is still `ALTER TYPE … ADD VALUE`, so keep new ones at the end.
enum NotificationType {
  POST_LIKE
  COMMENT_LIKE
  /// An admin published into a group you belong to. Unlike the two above this is a
  /// **fan-out**: one row per approved member of the group. See `notifyNewPost`.
  NEW_POST
  /// Somebody commented on your post. The subject is the **comment**, not the post — see
  /// `notifyComment` for why.
  POST_COMMENT
  /// Somebody started following you. The subject is the **actor**, because a follow is
  /// identified by the pair and has no object of its own — so keying on the follower is
  /// what makes one row per follower, and it is also what the panel row opens.
  FOLLOW
  /// A shift you signed up for is coming up. The subject is the **reminder row**, not the
  /// claim — one claim produces a reminder a week out and another a day out, and keying on
  /// the claim would collapse the two into one row under the unique key below.
  ///
  /// The only kind whose actor is the recipient themselves: nobody did this to you, the
  /// clock did. See `notifySignupReminder`.
  SIGNUP_REMINDER
  /// An admin called off a slot you had signed up for. The subject is the **slot**, because
  /// there is one cancellation per slot however many reminders were pending on it.
  SIGNUP_CANCELED
  /// An admin published a new rota into a group you belong to. A **fan-out**, like NEW_POST and
  /// for the same reason: a rota nobody knows about gets no volunteers. The subject is the
  /// sheet, and it is the only sign-up notification that is not about a date.
  SIGNUP_PUBLISHED
  /// An admin admitted you to a group. The subject is the **group**, so re-admitting somebody
  /// an admin had revoked settles at one row rather than accumulating them, and the row is
  /// what the panel opens: tapping it selects that group.
  ///
  /// Delivered by push to somebody who has signed in before and by email to somebody who has
  /// not, since a person provisioned a minute ago has no device to push to. See `admitOne`.
  ADDED_TO_GROUP

  @@map("notification_type")
}

/// One installation of the app that can be pushed to: an FCM registration token, and the
/// person currently signed in on it.
///
/// **The token is the identity, not the device.** `token` is the primary key rather than a
/// cuid with a unique index on it, because FCM already guarantees the token is unique and
/// there is no other name for this row — nothing links to it, and the only lookups are "who
/// is this token for" (on re-registration) and "every token for this person" (on send).
/// A surrogate id would be a second identifier for a value that is already one.
///
/// **`profileId` is mutable, and that is the point.** A phone signed out of and back into
/// by a different person keeps the same FCM token, so registration is an upsert that
/// *reassigns* the row. Without that, one row per (person, token) pair means the previous
/// occupant's tokens accumulate and a shared phone keeps buzzing with a stranger's likes —
/// which is a privacy failure, not a papercut. Sign-out deletes the row outright; the
/// reassignment is the belt to that's braces, for the sign-out that never reached the API.
///
/// **There is no `enabled` flag.** Whether the OS will actually deliver is the OS's answer,
/// not ours, and mirroring it here creates a fact that goes stale the moment someone turns
/// notifications off in Settings without opening the app. A revoked permission surfaces as
/// FCM rejecting the token with UNREGISTERED, which is what `prunePushTokens` deletes on.
model DeviceToken {
  /// The FCM registration token. Long, opaque, and rotated by the SDK — see `onTokenRefresh`
  /// in `lib/push.js`, which re-registers rather than editing in place.
  token String @id

  /// Who is signed in on this installation right now. Reassigned on re-registration.
  profileId String @map("profile_id") @db.Uuid

  /// "ios" | "android". Not an enum: a third value ("web", once web push lands) must not
  /// cost an `ALTER TYPE` on a live database for a column nothing branches on. It exists to
  /// answer "which platforms is this parish actually on" and to scope a future recall of a
  /// bad token batch, not to route a send — FCM takes the same shape for all of them.
  platform String

  createdAt DateTime @default(now()) @map("created_at")
  /// Last time the app re-registered this token. A token FCM has not rejected but that no
  /// device has presented in months is an uninstalled app; `prunePushTokens` has nothing to
  /// go on without this, since a dead token that is never sent to is never rejected either.
  seenAt    DateTime @default(now()) @updatedAt @map("seen_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// The one send-side query: every token belonging to a set of recipients. Also the index
  /// that keeps ON DELETE CASCADE off a sequential scan, which an unindexed foreign key
  /// would leave it as.
  @@index([profileId])
  @@map("device_token")
}

// ─────────────────────────────────────────────────────────────────────────────
// The social graph
// ─────────────────────────────────────────────────────────────────────────────

/// An asymmetric follow between two people (Twitter-style, not a friendship).
///
/// **It grants nothing, and that is deliberate.** Following somebody does not widen what you
/// may read: `readableOrgIds` is still the union of your APPROVED memberships and nothing
/// consults this table to build a feed. What it is, today, is a list — the one a person keeps
/// of the people they want to stay in touch with — and what it is *for* is direct messaging,
/// where "who can I start a conversation with" needs an answer that is not "everyone in the
/// diocese". Until that ships this is a list and should stay one; making the feed read it
/// would put another person's parish's posts in front of somebody with no membership in it,
/// which is the one invariant this app has.
///
/// Who may follow whom is `visibleProfile` in `follows.service.js`: you can follow a person
/// you share an APPROVED group with, because that is the boundary of who you can see at all.
///
/// **No denormalized tallies.** `Post.likeCount` is a column because every card in a page
/// renders it; a follower count is rendered on one profile at a time, so it is a `_count` on
/// the read that was already being made rather than two more columns to keep in step.
model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  Profile @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following Profile @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  /// The pair is the identity: one row per direction, and a double-tap is idempotent at the
  /// database level rather than in application code. Same argument as `PostLike`.
  @@id([followerId, followingId])
  /// The two list reads, each in the order its keyset cursor compares — so a page of
  /// followers or of following is an index range scan.
  ///
  /// The tiebreaker is the *other* person's id rather than a surrogate `id`, because this
  /// table has none: the pair is the key. That is what `keysetWhere`'s `tiebreaker` argument
  /// exists for; see `lib/server/cursor.js`.
  @@index([followingId, createdAt(sort: Desc), followerId(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc), followingId(sort: Desc)])
  @@map("follow")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sign-ups
//
// A parish runs on rotas: somebody brings the food after Liturgy, four people cook at the
// soup kitchen, six two-hour shifts cover the festival's parking lot over one weekend. All
// three are the same shape — an admin publishes a list of dated slots, each with room for
// some number of people, and members take one.
//
// ── Three tables, and the middle one is why ──────────────────────────────────
//
// `SignupSheet` is the rota ("Coffee hour"). `SignupSlot` is one dated opening on it, and
// `SignupClaim` is a person in it. The slots are **materialized rows, not a recurrence rule
// evaluated at read time**, and that is the decision the whole feature rests on: an admin
// has to be able to say "no soup kitchen on the 24th, and we need six people on the 31st".
// A rule cannot hold an exception without growing a second table of exceptions, which is the
// slot table with extra steps — and every read would then have to expand a rule before it
// could join a claim to it. The generator in `signups.service.js` is what keeps the rule's
// convenience: it writes the rows, and after that they are ordinary rows an admin can edit
// one at a time.
//
// (The parish's *own* calendar is the opposite case and is deliberately not modeled here at
// all. It is a Google Calendar the parish already keeps, read as an iCalendar feed and
// expanded per request — see `Organization.calendarUrl`. Copying it into these tables would
// make Grapevine a second place the same events have to be corrected.)
// ─────────────────────────────────────────────────────────────────────────────

/// A rota published into one group: a title, and the dated slots below it.
///
/// Always scoped to an organization, exactly as a `Post` is, and only an ADMIN of that
/// organization may publish or edit one — enforced in the service, not here.
///
/// **`timezone` is the parish's clock, and it is stored because the generator needs it.**
/// The slots below hold absolute instants, so nothing *reads* this column to render a time.
/// What needs it is writing them: "every Sunday at 11:00" across twelve weeks crosses a
/// daylight-saving boundary, and generating those from a fixed offset puts half the autumn
/// on the hour it is not. Captured from the admin's own device at creation, which is the
/// parish's clock by construction, since the person publishing the parish's rota is standing
/// in the parish.
model SignupSheet {
  id          String  @id @default(cuid())
  orgId       String  @map("org_id")
  title       String
  description String?
  /// IANA zone name, e.g. "America/Chicago". See the note above.
  timezone    String  @default("UTC")

  /// The title this rota appears under on the parish's own calendar, when it is not the
  /// title above.
  ///
  /// **The parish keeps one event in two places and neither is wrong.** "Cathedral's Kitchen"
  /// is on the Google Calendar because it is a thing that happens; "Cathedral kitchen" is a
  /// rota because it needs hands. A reader should see one entry, not two — so `mergeCalendar`
  /// matches a slot to a parish event by normalized title on the same day, and folds them.
  ///
  /// Null means "match on `title`", which is what the automatic case does and what almost
  /// every sheet will hold. This column is the **escape hatch**: it is for the rota the parish
  /// calls something else in its calendar ("Coffee hour" against "Fellowship Hour"), where no
  /// string rule could be expected to guess. Setting it to a title that matches nothing is
  /// also how an admin switches merging off for one sheet.
  calendarTitle String?      @map("calendar_title")
  status        SignupStatus @default(OPEN)

  /// Whether this rota goes on indefinitely — "every Saturday, forever", which is what most of
  /// a parish's standing rotas actually are. A festival's car park is the other kind: a fixed
  /// span of dates that finishes and is done.
  ///
  /// **It does not store a rule, and that is the point.** Extending a weekly rota needs one
  /// thing the rows already hold: the last day on it. The next occurrence is that day's slots a
  /// week later, at the same wall-clock time in `timezone` — so a flag is enough, and there is
  /// no second copy of the schedule to disagree with the dates it produced. It also means an
  /// admin who moves the rota to ten o'clock has moved every future one, without editing a rule
  /// they never saw.
  ///
  /// Topped up to `SIGNUP_HORIZON_DAYS` by `topUpRecurring` when the rota is read. See that
  /// function for why a read writes, and for the ceiling: `MAX_SHEET_SLOTS` is about ten years
  /// of a weekly rota, after which it stops extending and wants a prune rather than a raise.
  repeats Boolean @default(false)

  /// Whether taking a date on this rota shows what the Church keeps that day.
  ///
  /// **A rota about food is a rota about the fast.** Somebody signing up for coffee hour three
  /// Sundays out is deciding what to cook, and the one fact that decides it is whether that day
  /// is a fast. So the sign-up surface can carry the day's rule, read from the same almanac the
  /// Daily Read uses (`getFastingRule`) rather than stored here: a rule is a fact about a date,
  /// it is the same for every parish, and copying it onto a slot would be a second place the
  /// calendar of the Church has to be corrected.
  ///
  /// The creator's to set, because only they know what the rota is for: it belongs on the
  /// kitchen and coffee hour, and says nothing on a cleaning rota or a car park. Hence the
  /// default: off, which is what every rota that predates the column means.
  showFasting Boolean @default(false) @map("show_fasting")

  createdById String @map("created_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete, for the reason a post has one: a removed sheet must not take the record of
  /// who volunteered with it, and every read filters on `deletedAt: null`.
  deletedAt DateTime? @map("deleted_at")

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy     Profile        @relation("SheetCreator", fields: [createdById], references: [id], onDelete: Cascade)
  slots         SignupSlot[]
  notifications Notification[]

  /// The one list read: a group's live sheets, newest first, paged by keyset — sort columns
  /// in the order the cursor compares them.
  @@index([orgId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdById])
  @@map("signup_sheet")
}

/// Open or closed to new volunteers. Closing is not deleting: the slots and the people in
/// them stay readable, which is what a rota for last weekend is for.
enum SignupStatus {
  OPEN
  CLOSED

  @@map("signup_status")
}

/// One dated opening on a sheet — "Sunday 7 June, 11:00–12:30, room for 4".
///
/// **`capacity` is per slot rather than per sheet**, because the number moves within one rota:
/// the soup kitchen wants four cooks most weeks and six at Pascha, and the festival's Friday
/// evening needs more hands than its Sunday morning. The sheet's create form supplies one
/// number to every slot it generates; after that each row is the admin's to change.
///
/// **`canceledAt` rather than a delete**, and the distinction is the volunteers'. Deleting the
/// row would silently drop the people who had already claimed it — they would simply stop
/// seeing it, having been told nothing. Cancelling keeps the claims, notifies everyone in
/// them (`notifySignupCanceled`), and leaves the day visibly struck through, which is the
/// honest picture of "we are not doing it that week". Deleting a slot is still possible and is
/// for a slot nobody has taken.
model SignupSlot {
  id      String @id @default(cuid())
  sheetId String @map("sheet_id")

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// How many people this slot has room for. One for coffee hour, four for the kitchen.
  capacity Int     @default(1)
  /// An admin's word about this one date — "Bring bread, not a full meal".
  note     String?

  canceledAt DateTime? @map("canceled_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  sheet         SignupSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  claims        SignupClaim[]
  notifications Notification[]

  /// One slot per start time per sheet, and the constraint earns its keep at the point a
  /// rota is **extended**: "add another twelve Sundays" is the same generator run again over
  /// an overlapping range, and `createMany({ skipDuplicates: true })` turns that into "add
  /// the ones that are not there yet" for free. Without it, an admin who taps Extend twice
  /// gets two coffee hours on every Sunday and no way to tell which one people signed up for.
  ///
  /// It also says something true about the domain: two openings at the same moment on the
  /// same rota is what `capacity` is for.
  @@unique([sheetId, startsAt])
  /// The sheet's slots in date order, and the calendar's "which slots fall in this month".
  /// The second read is across a group rather than a sheet, so it joins through `sheet` —
  /// which is what the leading `sheetId` here serves.
  @@index([sheetId, startsAt])
  /// The compiled calendar's window read, which asks for a date range across every sheet in a
  /// group and then narrows by the sheets it already resolved.
  @@index([startsAt])
  @@map("signup_slot")
}

/// One person in one slot.
///
/// **`onBehalfOf` is why this is not just a join row.** A parish rota is routinely taken by a
/// body rather than a person: the Orthodox Christian Fellowship signs up for coffee hour and
/// sends whoever it sends. One member still claims it — somebody has to be answerable, and
/// the reminder has to reach an inbox — but the calendar should read "OCF" where it would
/// otherwise read a name. Free text rather than a foreign key to `Organization`: the bodies a
/// parish's volunteers stand for are mostly not groups in this app, and making them be one
/// would mean creating a Grapevine group before you can bring biscuits.
///
/// `@@unique([slotId, profileId])` is one spot per person per slot, settled at the database
/// level rather than in application code — the same argument as `PostLike`'s composite key.
/// Signing up twice for the same shift on behalf of two bodies is not a thing a parish means
/// to do; it is a double tap.
model SignupClaim {
  id         String  @id @default(cuid())
  slotId     String  @map("slot_id")
  profileId  String  @map("profile_id") @db.Uuid
  /// The body this person is standing for, if any. See the note above.
  onBehalfOf String? @map("on_behalf_of")
  /// What they are bringing, or anything else the rest of the parish should know.
  note       String?

  createdAt DateTime @default(now()) @map("created_at")

  slot      SignupSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reminders SignupReminder[]

  @@unique([slotId, profileId])
  /// "My sign-ups" — this person's claims, soonest first. The slot's date lives on the slot,
  /// so this index gets the rows and the join orders them.
  @@index([profileId])
  @@map("signup_claim")
}

/// One scheduled nudge for one claim: send this reminder at this instant, and here is when it
/// went.
///
/// **A row per reminder, rather than a flag on the claim**, because there are two of them per
/// sign-up (a week out and a day out — `SIGNUP_REMINDER_OFFSETS` in `lib/constants.js`) and
/// they have to be individually idempotent. `sentAt` is the marker: the sender claims rows
/// with a conditional update, so a cron that runs twice, or two of them running at once,
/// cannot send the same nudge twice.
///
/// Turning reminders off is deleting the pending rows, which is why "remind me" needs no
/// column of its own — a claim with no unsent reminders is a claim nobody will be nudged
/// about, and that is the same state as one made with the toggle off.
///
/// Nothing here is sent by the web request that created it. Delivery is
/// `npm run signups:remind`, run on a schedule — see `scripts/send-reminders.mjs`.
model SignupReminder {
  id      String @id @default(cuid())
  claimId String @map("claim_id")

  /// When this should go out — the slot's start minus one of the offsets.
  sendAt DateTime  @map("send_at")
  /// When it actually did. Null is "pending", and the only thing the sender looks for.
  sentAt DateTime? @map("sent_at")

  claim SignupClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  /// One reminder per claim per instant, so re-running the generator for a claim is a no-op
  /// rather than a second nudge.
  @@unique([claimId, sendAt])
  /// The sender's one query: everything unsent and due. `sentAt` leads because it is the
  /// selective column — almost every row in this table has been sent — and Postgres can range
  /// scan `send_at` inside the null group.
  @@index([sentAt, sendAt])
  @@map("signup_reminder")
}

// ─────────────────────────────────────────────────────────────────────────────
// Direct messages — end-to-end encrypted
//
// The server relays and stores ciphertext; it can never read a message. Every
// installation of the app is a `CryptoDevice` running the Signal protocol
// (X3DH + Double Ratchet, implemented in `src/lib/crypto` from signal.org's
// published specifications), and a message is encrypted once per recipient
// device — so `Message` carries no body at all, only `MessageEnvelope` rows.
// Plaintext exists only on devices: each client caches what it has decrypted,
// and a reinstalled app is a new device that can read everything from then on
// and nothing from before. That is Signal's own trade and it is deliberate —
// there is no key escrow, no backup, and nothing here worth subpoenaing.
//
// Who may message whom is the membership graph again: one shared APPROVED group
// (the same `visibleProfile` rule the profile card answers to), both parties 18
// or older by `Profile.birthday`, and no `MessageBlock` between them. A first
// message from someone the recipient does not follow arrives as a *request* —
// `ConversationParticipant.acceptedAt` — and stays blurred and unanswerable
// until accepted, per Signal's message-request pattern.
// ─────────────────────────────────────────────────────────────────────────────

/// A message thread. Participants live in a join table rather than as `userAId` /
/// `userBId`, so the same model serves a direct message and an N-way group thread
/// with no change — that is the whole reason for the indirection.
model Conversation {
  id            String   @id @default(cuid())
  /// Optional organization scope, so a parish can host a group thread. Deliberately
  /// not a foreign key yet — group threads will decide whether a deleted group takes
  /// its threads with it.
  orgId         String?  @map("org_id")
  /// Who opened the thread. What makes the *other* participant's row a request —
  /// their `acceptedAt` starts null unless they already followed the opener. SetNull
  /// rather than Cascade, because the conversation is as much the recipient's as the
  /// sender's and an erased account must not take someone else's half with it.
  createdById   String?  @map("created_by_id") @db.Uuid
  /// Denormalized so an inbox list can sort without touching the messages table.
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  createdBy    Profile?                  @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@map("conversation")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id")
  profileId      String    @map("profile_id") @db.Uuid
  /// Drives the unread badge: messages newer than this are unread.
  lastReadAt     DateTime? @map("last_read_at")
  /// Null is a pending message request: the thread renders blurred, with
  /// Accept/Delete/Block in place of a composer, and the sender is not told the
  /// request was seen. Set at admission for the opener and for a recipient who
  /// already follows them — following someone is standing permission to be written
  /// to, which is the one thing `Follow` grants anywhere in the app.
  acceptedAt     DateTime? @map("accepted_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([conversationId, profileId])
  /// Serves "my inbox".
  @@index([profileId])
  @@map("conversation_participant")
}

/// One message event. **No body column** — the content is the per-device
/// `MessageEnvelope` rows, and a message with no envelope for your device is one
/// you can never read (a device registered after it was sent, which is the
/// no-backup trade described in the section header).
model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id") @db.Uuid
  /// Which installation encrypted this — the recipient's session is keyed by the
  /// sender's *device*, not the sender. A plain string rather than a foreign key,
  /// because a sender wiping their install must not take delivered mail with it:
  /// the recipient's session under this id keeps decrypting what it already holds.
  senderDeviceId String    @map("sender_device_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  envelopes    MessageEnvelope[]

  /// Matches the thread's keyset pagination order.
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId])
  @@map("message")
}

/// How a ciphertext is framed, mirroring the Signal wire's two message types. A
/// PREKEY envelope carries the X3DH handshake (the sender's identity and ephemeral
/// keys and which prekeys were used) alongside the first ciphertext, so a session
/// begins with no round trip to the other device; RATCHET is every message once a
/// session exists.
enum EnvelopeType {
  PREKEY
  RATCHET

  @@map("envelope_type")
}

/// One message, encrypted for one device. The sender writes one of these per
/// recipient device *and* per other device of their own (so their own phone and
/// laptop both read what either sent); each device fetches only rows addressed
/// to it. Ciphertext is base64, opaque to the server by construction.
model MessageEnvelope {
  messageId String       @map("message_id")
  deviceId  String       @map("device_id")
  type      EnvelopeType
  body      String

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  device  CryptoDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([messageId, deviceId])
  /// A device paging a thread asks "envelopes for me" — the message side is the
  /// primary key's leading column, so only this direction needs an index.
  @@index([deviceId])
  @@map("message_envelope")
}

/// One installation's public half of the Signal protocol: the identity key and the
/// signed prekey that let a stranger start an encrypted session without the device
/// being online. The private halves never leave the device.
///
/// The id is minted by the client (a uuid, generated once per install) rather than
/// by the database, because sessions on *other* devices are keyed by it — a
/// server-assigned id would mean a device does not know its own name until it has
/// registered, and re-registering (refreshing prekeys) must not change it.
model CryptoDevice {
  id        String @id
  profileId String @map("profile_id") @db.Uuid

  /// Ed25519 public key, base64. Doubles as the DH identity via the birational map
  /// to X25519 — see `src/lib/crypto/primitives.js` for why the master key is
  /// Edwards rather than Montgomery.
  identityKey String @map("identity_key")

  /// The medium-term X25519 prekey X3DH falls back to when the one-time pool is
  /// empty, signed by the identity key so a malicious server cannot substitute its
  /// own. Rotated by the client; `keyId` is how a sender names which one it used.
  signedPreKeyId        Int    @map("signed_pre_key_id")
  signedPreKey          String @map("signed_pre_key")
  signedPreKeySignature String @map("signed_pre_key_signature")

  /// Random per-install tag from the Signal wire format, carried in envelope
  /// headers so a device can cheaply reject traffic for a stale install of itself.
  registrationId Int @map("registration_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  preKeys   OneTimePreKey[]
  envelopes MessageEnvelope[]

  /// Serves "every device this message must be encrypted for".
  @@index([profileId])
  @@map("crypto_device")
}

/// A single-use X25519 prekey. X3DH consumes one per new session — the fetch that
/// hands it to a sender deletes it in the same transaction, which is what gives the
/// first message forward secrecy against a later identity-key compromise. The
/// client tops the pool up when registration reports it low.
model OneTimePreKey {
  deviceId String @map("device_id")
  keyId    Int    @map("key_id")
  key      String

  device CryptoDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, keyId])
  @@map("one_time_pre_key")
}

/// One person refusing another's messages, written from a request's Block action.
/// A block freezes the pair in both directions — checked at conversation creation
/// and on every send, so it bites on existing threads too — but the row records
/// who did it, because only they may undo it. Deliberately not surfaced to the
/// blocked party: their attempt fails as if the person had simply never replied.
model MessageBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker Profile @relation("BlockMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("BlockReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  /// The send-time check asks "has my recipient blocked me", which enters by the
  /// blocked side.
  @@index([blockedId])
  @@map("message_block")
}
